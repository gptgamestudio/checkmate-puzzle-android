rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // ONLY OWNER analynlandingin77@gmail.com OR VERIFIED ADMIN HAS FULL APP & ADMIN ACCESS
    function isAppOwner() {
      return isAuthenticated() && (
        (request.auth.token.email == "analynlandingin77@gmail.com" &&
          (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com')) ||
        request.auth.token.admin == true
      );
    }

    function isUserSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.userId is string
        && data.userId == userId
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 50
        && data.rating is int
        && data.rating >= 0
        && data.rating <= 4000
        && data.solvedCount is int
        && data.solvedCount >= 0
        && data.solvedCount <= 2000
        && data.currentPuzzleId is int
        && data.currentPuzzleId >= 1
        && data.currentPuzzleId <= 2001;
    }

    function isValidProgress(data, userId) {
      return data.userId is string
        && data.userId == userId
        && data.puzzleId is int
        && data.puzzleId >= 1
        && data.puzzleId <= 2000
        && data.solved is bool;
    }

    // 1. OWNER-ONLY ADMIN SETTINGS, CONFIGURATION & AUDIT
    match /admin_settings/{settingId} {
      allow read, write: if isAppOwner();
    }

    match /owner_audit/{auditId} {
      allow read, write: if isAppOwner();
    }

    match /game_system/{docId} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    // 2. USER PROGRESS & LEADERBOARD
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUserSelf(userId) && isValidUser(request.resource.data, userId);
      // Prevent users from elevating roles or modifying other users' data
      allow update: if (isUserSelf(userId) && isValidUser(request.resource.data, userId) && !('role' in request.resource.data.diff(resource.data).affectedKeys())) || isAppOwner();
      allow delete: if isUserSelf(userId) || isAppOwner();

      match /progress/{puzzleId} {
        allow read: if isUserSelf(userId) || isAppOwner();
        allow create, update: if (isUserSelf(userId) && isValidProgress(request.resource.data, userId)) || isAppOwner();
        allow delete: if isUserSelf(userId) || isAppOwner();
      }
    }

    // 3. GLOBAL COMPETITIVE LEADERBOARD (Public Read, Server/Admin Authoritative Write)
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    // 4. MATCH HISTORY (User can read own matches, cannot forge other players' matches)
    match /match_history/{matchId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAppOwner());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAppOwner();
    }
  }
}
